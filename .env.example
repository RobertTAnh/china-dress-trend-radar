# Sao chép file này thành .env rồi chỉnh theo máy bạn.
# Không điền API key thật vào git.

APP_NAME=China Dress Trend Radar
APP_HOST=127.0.0.1
APP_PORT=8000

# Mặc định chạy đầy đủ không cần TikHub. Đặt false chỉ khi bạn đã xác nhận gọi API thật.
MOCK_MODE=true

# Bắt buộc khi MOCK_MODE=false. Không commit giá trị thật.
TIKHUB_API_KEY=

TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_SEARCH_ENDPOINT=/api/v1/douyin/search/fetch_video_search_v2
TIKHUB_SEARCH_FALLBACK_ENDPOINT=/api/v1/douyin/search/fetch_general_search_v2
TIKHUB_STATS_ENDPOINT=/api/v1/douyin/app/v3/fetch_multi_video_statistics
TIKHUB_USE_FALLBACK_SEARCH=false

DATABASE_URL=sqlite:///./data/radar.db

USD_VND_RATE=26000
COST_PER_SEARCH_USD=0.01
COST_PER_STATS_USD=0.025
MAX_REQUESTS_PER_RUN=35
MAX_REQUESTS_PER_MONTH=400
PAGES_PER_KEYWORD=3
MAX_DETAIL_VIDEOS_PER_RUN=50
INTERNAL_RATE_LIMIT_RPS=2.0

SEARCH_SORT_TYPE=0
SEARCH_PUBLISH_TIME=7
SEARCH_CONTENT_TYPE=1

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Bangkok
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0

LOG_LEVEL=INFO

# Desktop Electron: railway | local
DESKTOP_MODE=railway
RAILWAY_APP_URL=https://web-production-f29ae8.up.railway.app

# --- Apify Douyin Shop products (Free Preview) ---
# Không commit token thật. Mặc định mock để phát triển không tốn tiền.
APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com
APIFY_ACTOR_ID=zen-studio/douyin-product-search-scraper
APIFY_MONTHLY_BUDGET_USD=4.50
APIFY_ESTIMATED_PRICE_PER_1000_PRODUCTS=7.99
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_POLL_INTERVAL_SECONDS=5

PRODUCT_RESULTS_PER_KEYWORD=20
PRODUCT_MAX_KEYWORDS_PER_RUN=1
PRODUCT_CRAWL_ENABLED=false
PRODUCT_FREE_PREVIEW_MODE=true
PRODUCT_FREE_PREVIEW_RUN_LIMIT=10
PRODUCT_AUTO_SCHEDULE_ENABLED=false
PRODUCT_MOCK_MODE=true

# --- Xiaohongshu (MediaCrawler local → Railway ingest) ---
# Token chỉ dùng trên Railway / máy local. Không commit giá trị thật.
XHS_INGEST_TOKEN=
XHS_INGEST_MAX_BODY_MB=8
XHS_MAX_ITEMS_PER_KEYWORD=30
# Đường dẫn MediaCrawler ngoài repo — chỉ dùng trên máy Windows.
MEDIACRAWLER_PATH=C:\tools\MediaCrawler
MEDIACRAWLER_PYTHON=C:\tools\MediaCrawler\.venv\Scripts\python.exe
XHS_RAILWAY_URL=https://web-production-f29ae8.up.railway.app
